    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const assessment = item.json.assessment;\n  const repoUrl = assessment.assessedSoftware?.url || null;\n\n  let owner = null;\n\n  if (repoUrl) {\n    const match = repoUrl.match(/^https?:\\/\\/github\\.com\\/([^\\/]+)\\/([^\\/]+?)(?:\\/)?$/);\n    if (match) {\n      owner = match[1];\n    }\n  }\n\n  item.json.assessment = {\n    ...assessment,\n    \"@id\": assessment[\"@id\"] || (\n      repoUrl\n        ? `${repoUrl}/assessment/${assessment.dateCreated}`\n        : null\n    ),\n    author: owner\n\n    \n  };\n\n  return item;\n});\n"
      },
