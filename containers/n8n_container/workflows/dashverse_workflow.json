    {
      "parameters": {
        "jsCode": "const source = \"rsfc\"; \n\nreturn $input.all().map(item => {\n  const assessment = item.json.assessment;\n  const repoUrl = assessment.assessedSoftware?.url || null;\n\n  const match = repoUrl?.match(\n    /^https?:\\/\\/github\\.com\\/([^/]+)\\/[^/]+\\/?$/i\n  );\n  const owner = match?.[1] || null;\n\n  const generatedId =\n    repoUrl && assessment.dateCreated\n      ? `${repoUrl}/assessment/${source}/${encodeURIComponent(assessment.dateCreated)}`\n      : null;\n\n  item.json.assessment = {\n    ...assessment,\n    \"@id\": assessment[\"@id\"] || generatedId,\n    author: assessment.author ?? owner,\n  };\n\n  return item;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
