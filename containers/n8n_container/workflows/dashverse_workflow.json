      "id": "57e5c3d0-a10b-4385-a921-aab09f3a26b5",
      "name": "Trigger"
    },
    {
      "parameters": {
        "jsCode": "const project = $(\"Trigger\").first().json.project;\n\nreturn $input.all().map(item => {\n  const repoUrl = String(item.json.repos_url)\n    .trim()\n    .replace(/\\/+$/, \"\")\n    .replace(/\\.git$/i, \"\");\n\n  const match = repoUrl.match(\n    /^https?:\\/\\/github\\.com\\/([^/]+)\\/([^/]+)$/i\n  );\n\n  if (!match) {\n    throw new Error(`Invalid GitHub repository URL: ${repoUrl}`);\n  }\n\n  const [, owner, repo] = match;\n\n  return {\n    json: {\n      project,\n      repo_url: repoUrl,\n      owner,\n      repository_key: `${owner}_${repo}`.replace(/\\./g, \"-\"),\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -992,
        224
      ],
      "id": "e73ac9a7-2e86-4c64-b2e6-562fc39c88cc",
      "name": "Code url->target-name"
    },
    {
      "parameters": {
        "fieldToSplitOut": "repos_url",
        "options": {}
      },
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        -1248,
        224
      ],
      "id": "b3a0901a-67b8-472c-84d2-8fd1c8753477",
      "name": "Split Out"
    },
    {
      "parameters": {
        "executeOnce": false,
        "command": "=python3 /opt/dashverse_runner/build_sqoo_assessment.py \\\n  --rsfc /root/.n8n-files/rsfc/{{$json.project}}/{{$json.repository_key}}/rsfc_output/rsfc_assessment.json \\\n  --resqui /root/.n8n-files/resqui/{{$json.project}}/{{$json.repository_key}}/resqui_summary.json \\\n  --rsfc-indicators /opt/dashverse_runner/rsfc_indicators.json \\\n  --output /root/.n8n-files/sqoo_assessments/{{$json.repository_key}}_assessment.json"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -800,
