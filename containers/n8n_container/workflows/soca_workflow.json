    {
      "parameters": {
        "jsCode": "const parseList = (value) =>\n  String(value ?? '')\n    .split(/\\r?\\n/)\n    .map(repo => repo.trim())\n    .filter(Boolean);\n\nconst reposUpdated = parseList($json.updated_text);\nconst reposRemoved = parseList($json.removed_text);\nconst allRepos = parseList($json.all_repos_text);\n\nreturn [{\n  json: {\n    repos_url: reposUpdated,\n    repo_count: reposUpdated.length,\n\n    all_repos_url: allRepos,\n    all_repo_count: allRepos.length,\n\n    repos_removed: reposRemoved,\n    removed_count: reposRemoved.length,\n\n    has_changes:\n      reposUpdated.length > 0 || reposRemoved.length > 0,\n\n    project: $(\"Trigger\").first().json.project,\n  },\n}];"
      },
