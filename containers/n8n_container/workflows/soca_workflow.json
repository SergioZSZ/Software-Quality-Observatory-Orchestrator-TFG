      "position": [
        320,
        48
      ],
      "id": "6926b27f-bae0-4a16-a1de-72b238cb6d99",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "command": "=docker run --rm \\\n--network containers_net \\\n-v \"{{ $env.OUTPUTS }}:/app/outputs\" \\\n-e TARGET={{ $json.target }} \\\n-e TYPE={{ $json.type }} \\\n-e GITHUB_TOKEN={{ $env.GITHUB_API_TOKEN }} \\\n-e RABBITMQ_HOST={{ $env.RABBITMQ_HOST }} \\\n-e RABBITMQ_USER={{ $env.RABBITMQ_USER }} \\\n-e RABBITMQ_PASSWORD={{ $env.RABBITMQ_PASSWORD }} \\\nsoca-heavy:latest \\\npython -m soca_runner.main \\\n{{ $json.mode === \"manual\" \n    ? \"--repos /app/outputs/\" + $json.repos + \" --name \" + $json.target \n    : \"\" \n}}"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -32,
        48
      ],
      "id": "c0ec8864-f567-4469-bce4-c89ceea6b5f1",
      "name": "Execute soca-runner"
    },
    {
      "parameters": {
        "fileSelector": "=/root/.n8n-files/soca/{{$node[\"Trigger\"].json.target}}/repos.txt",
        "options": {
          "fileExtension": ""
        }
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        160,
        48
      ],
      "id": "97e36988-076e-408c-a565-a41a6da0d00f",
      "name": "Read target repos"
    },
    {
      "parameters": {
        "jsCode": "const repos = $json.data\n  .split('\\n')\n  .map(r => r.trim())\n  .filter(r => r !== '');\n\nreturn [\n  {\n    json: {\n      repos_url: repos,\n      repo_count: repos.length\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        48
      ],
      "id": "1b9be4d4-91c9-418c-bdef-c6978fb0da37",
      "name": "Code repo_url list & repo count"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1312,
        240
      ],
      "id": "e623eb39-a919-4966-8920-c619dee8f3ff",
      "name": "Wait",
      "webhookId": "6ddc46bd-8f5f-45d5-a3d0-03f984f5d555"
    },
    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      count: Number($json.stdout.trim())\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        48
      ],
      "id": "80fb7636-cd7d-481d-b115-01e1f7597269",
      "name": "Process metadata count"
    },
    {
      "parameters": {
        "command": "=find /root/.n8n-files/soca/{{$node[\"Trigger\"].json.target}}/metadata -maxdepth 1 -type f -name \"*.json\" | wc -l"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        48
      ],
      "id": "5369a196-c34f-4cf1-9b7f-95108ce7b81c",
      "name": "find metadatas json"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
