            "version": 3
          },
          "conditions": [
            {
              "id": "ea58b61e-9efd-4e17-9011-96d6ea283f75",
              "leftValue": "={{ $node[\"Process metadata count\"].json.count}}",
              "rightValue": "={{ $node[\"Code repo_url list & repo count\"].json.repo_count }}",
              "operator": {
